def update_js(new_version)
  path = Dir['../plugin/src/**/QonversionInternal.ts'].first
  regex = /const sdkVersion = ".*";/
  result_value = "const sdkVersion = \"#{new_version}\";"

  update_file(path, regex, result_value)
end

def update_package(new_version)
  path = "../plugin/package.json"
  regex = /"version": ".*",/
  result_value = "\"version\": \"#{new_version}\","

  update_file(path, regex, result_value)
end

def update_plugin_xml(new_version)
  path = "../plugin/plugin.xml"
  regex = /id="@qonversion\/cordova-plugin" version=".*"/
  result_value = "id=\"@qonversion/cordova-plugin\" version=\"#{new_version}\""

  update_file(path, regex, result_value)
end

def upgrade_sandwich_android(new_version)
  update_file_strict("../plugin/plugin.xml", /<framework src="io\.qonversion:sandwich:.*" \/>/, "<framework src=\"io.qonversion:sandwich:#{new_version}\" />")
end

# The sandwich pin lives in plugin.xml (CocoaPods, cordova-ios < 8) and Package.swift (SwiftPM, cordova-ios 8+);
# they must always match.
def upgrade_sandwich_ios(new_version)
  update_file_strict("../plugin/plugin.xml", /<pod name="QonversionSandwich" spec=".*" nospm="true" \/>/, "<pod name=\"QonversionSandwich\" spec=\"#{new_version}\" nospm=\"true\" />")
  update_file_strict("../plugin/Package.swift", /sandwich-sdk.git", exact: ".*"\)/, "sandwich-sdk.git\", exact: \"#{new_version}\")")
end

# Every manifest the sandwich pin lives in, with the pattern that must match exactly once.
SANDWICH_PIN_FILES = {
  "../plugin/plugin.xml" => [/<framework src="io\.qonversion:sandwich:.*" \/>/, /<pod name="QonversionSandwich" spec=".*" nospm="true" \/>/],
  "../plugin/Package.swift" => [/sandwich-sdk.git", exact: ".*"\)/],
}

def assert_sandwich_pins_updatable
  SANDWICH_PIN_FILES.each do |path, regexes|
    regexes.each do |regex|
      matches = File.read(path).scan(regex).length
      UI.user_error!("#{path}: expected exactly one match for #{regex.inspect}, found #{matches}") unless matches == 1
    end
  end
end

# Like update_file, but fails loudly unless the pattern matches exactly once —
# a silent no-op would let the plugin.xml and Package.swift pins drift apart.
def update_file_strict(path, regex, result_value)
  file = File.read(path)
  matches = file.scan(regex).length
  UI.user_error!("#{path}: expected exactly one match for #{regex.inspect}, found #{matches}") unless matches == 1
  File.write(path, file.sub(regex, result_value))
end

def update_file(path, regex, result_value)
  file = File.read(path)
  new_content = file.gsub(regex, result_value)
  File.open(path, 'w') { |line| line.puts new_content }
end

def get_tag
  tag = last_git_tag()
  puts tag
  result_tag = tag.scan(%r{\d{1,2}.\d{1,2}.\d{1,3}}).first
  return result_tag
end

def calculate_minor_version(tag)
  major, minor, patch = parse_versions(tag)
  new_minor_version = minor.to_i.next.to_s
  new_version = major + "." + new_minor_version + "." + "0"
  return new_version
end

def calculate_patch_version(tag)
  major, minor, patch = parse_versions(tag)
  new_patch_version = patch.to_i.next.to_s
  new_version = major + "." + minor + "." + new_patch_version

  return new_version
end

def parse_versions(tag)
  split_version_array = tag.split(".", 3)

  if split_version_array.length == 3
    major = split_version_array[0]
    minor = split_version_array[1]
    patch = split_version_array[2]

    return major, minor, patch
  end
end

lane :bump do |options|
  new_version = options[:version]

  update_js(new_version)
  update_package(new_version)
  update_plugin_xml(new_version)
end

lane :upgrade_sandwich do |options|
  new_version = options[:version]
  UI.user_error!("Pass version:x.y.z") unless new_version.to_s.match?(/\A\d+\.\d+\.\d+\z/)
  # Check every manifest first so a broken pattern cannot leave the tree half-bumped.
  assert_sandwich_pins_updatable

  upgrade_sandwich_android(new_version)
  upgrade_sandwich_ios(new_version)
end

lane :provide_next_patch_version do
  tag = get_tag
  new_version = calculate_patch_version(tag)
  sh("echo version=#{new_version} >> \"$GITHUB_ENV\"")
end
