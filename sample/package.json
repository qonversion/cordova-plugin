{
  "name": "com.qonversion.sample",
  "displayName": "Sample Qonversion Cordova App",
  "version": "1.0.0",
  "description": "A sample Apache Cordova application.",
  "main": "index.js",
  "scripts": {
    "clean": "cd ../plugin && yarn build && cd ../sample && (cordova plugin rm @qonversion/cordova-plugin || true) && cordova plugin add ../plugin",
    "android": "cordova run android -- --gradleArg=-PcdvCompileSdkVersion=33",
    "ios": "cordova run ios --emulator",
    "test": "echo \"Error: no test specified\" && exit 1",
    "xcode": "open ./platforms/ios/App.xcworkspace"
  },
  "keywords": [
    "ecosystem:cordova"
  ],
  "author": "Apache Cordova Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "@qonversion/cordova-plugin": "file:../plugin",
    "cordova-android": "^13.0.0",
    "cordova-annotated-plugin-android": "^1.0.4",
    "cordova-ios": "^8.1.1",
    "cordova-plugin-device": "^3.0.0"
  },
  "cordova": {
    "platforms": [
      "android",
      "ios"
    ],
    "plugins": {}
  }
}
