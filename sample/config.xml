<?xml version='1.0' encoding='utf-8'?>
<widget id="io.qonversion.sample" android-packageName="io.qonversion.sampleapp" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Qonversion Cordova</name>
    <description>Sample Qonversion Cordova App</description>
    <author email="dev@cordova.apache.org" href="https://cordova.apache.org">
        Apache Cordova Team
    </author>
    <content src="index.html" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <platform name="ios">
        <!-- QonversionSandwich requires iOS 13.0; cordova-ios 8 defaults to it, older cordova-ios versions default to 11.0. -->
        <preference name="deployment-target" value="13.0" />
    </platform>
</widget>
